# ── Voice (required for real renders; --draft works without it) ───────────────
ELEVENLABS_API_KEY=
# Voice to use. Run `npm run voices` to list the voices on your account.
ELEVENLABS_VOICE_ID=
# Optional. eleven_multilingual_v2 (default, most stable) | eleven_v4 | eleven_v3 | eleven_flash_v2_5 (fastest, cheapest)
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Script writing (only needed when you pass a brief instead of a storyboard) ─
ANTHROPIC_API_KEY=
# VIDGEN_MODEL=claude-opus-5-5

# ── Optional ─────────────────────────────────────────────────────────────────
# Use an existing Chrome/Chromium instead of the one Playwright downloads.
# CHROMIUM_PATH=
# FFMPEG_PATH=
